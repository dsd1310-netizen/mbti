{
  "name": "saju-mbti-app",
  "private": true,
  "version": "1.0.0",
  "main": "electron-main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dist": "tsc && vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.sajumbti.app",
    "productName": "SajuMBTI",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron-main.js"
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "typescript": "~5.6.2",
    "vite": "^5.4.11",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
